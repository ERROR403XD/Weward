BIND_HOST=127.0.0.1
COLLECTOR_PORT=18080
RECEIVER_PORT=18081
DESKTOP_PORT=6080
# Optional full browser URL for a separate desktop host or reverse proxy.
# DESKTOP_PUBLIC_URL=https://desktop.example.com/vnc.html?autoconnect=1&resize=scale&reconnect=0
TZ=Asia/Shanghai
WATCH_ROOM_REMARK=webox.weward
FORWARD_URL=http://receiver:8080/api/messages
INITIAL_LOOKBACK_SECONDS=300
WEBOX_IMAGE=weward-webox:8ca042c-wx4.1.1.8-compat3
WEBOX_STATE_DIR=./data/webox
COLLECTOR_DATA_DIR=./data/collector
RECEIVER_DATA_DIR=./data/receiver
# Optional compose.wechat-storage.yaml: relocate the complete xwechat_files directory.
# WECHAT_FILES_DIR=/mnt/storage/weward/xwechat_files
# Optional compose.nfs.yaml: keep databases local and move bulky media to NFS.
# WECHAT_ACCOUNT_DIR=wxid_example_suffix
# WECHAT_MEDIA_DIR=/mnt/nfs/weward/media
